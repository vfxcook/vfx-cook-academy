{
  "name": "@academy/web",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "BrahmAstra Academy client — Vite, React and React Router data loaders",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build:production": "vite build --mode production",
    "preview:worker": "npm run build && wrangler dev",
    "deploy:worker": "npm run build && wrangler deploy",
    "deploy:worker:preview": "npm run build && wrangler publish --preview",
    "deploy:worker:production": "npm run build && wrangler publish --env production"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^7.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.3",
    "vite": "^6.2.0"
  }
}
