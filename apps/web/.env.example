# Where the Vite dev server proxies /api during local development.
VITE_API_TARGET="http://127.0.0.1:8080"
VITE_PORT="5173"

# Only when the API is NOT reachable at this site's own /api (i.e. no Cloudflare Worker
# proxy): the absolute API origin, e.g. https://api.academy.brahmastra.studio.
VITE_API_BASE=""

# Overrides the Google client ID the API reports. Normally left empty.
VITE_GOOGLE_CLIENT_ID=""
