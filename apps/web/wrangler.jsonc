{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  // academy.frameon.si at the edge: the built SPA plus a thin proxy to the API on
  // Render, so the browser only ever talks to one origin and cookies stay first-party.
  "name": "academy",
  "main": "worker/index.ts",
  "compatibility_date": "2026-09-22",
  "compatibility_flags": ["nodejs_compat"],

  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    // Client-side routes (/learn/…, /admin/…) fall back to index.html.
    "not_found_handling": "single-page-application",
    // Only these reach the Worker; everything else is served straight from assets.
    "run_worker_first": ["/api/*", "/uploads/*", "/healthz", "/readyz"]
  },

  "vars": {
    // The Render web service. Update if the service is renamed.
    "API_ORIGIN": "https://vfx-cook-academy.onrender.com"
  },

  // Shared with the API so it can trust the visitor IP this Worker forwards:
  //   npx wrangler secret put PROXY_SHARED_SECRET
  "secrets": { "required": ["PROXY_SHARED_SECRET"] },

  // Needs the frameon.si zone on this Cloudflare account.
  "routes": [{ "pattern": "academy.frameon.si", "custom_domain": true }],

  // A workers.dev URL to preview the build on. Sign-in only works on the custom
  // domain: session cookies are scoped to .frameon.si.
  "workers_dev": true,

  "observability": {
    "enabled": true,
    "logs": { "enabled": true, "head_sampling_rate": 1 },
    "traces": { "enabled": true, "head_sampling_rate": 0.1 }
  }
}
