# ---------- database ----------
# Pooled connection for the app, direct connection for migrations.
DATABASE_URL="postgresql://postgres:password@db.example.supabase.co:6543/postgres?sslmode=require&pgbouncer=true"
DIRECT_URL="postgresql://postgres:password@db.example.supabase.co:5432/postgres?sslmode=require"

# ---------- app ----------
NODE_ENV="development"
PORT="8080"
# Public origin. In dev this is the Vite server; in production it is your domain.
APP_URL="http://localhost:5173"
# Signs nothing by itself, but is required in production as a deployment guard.
SESSION_SECRET="replace-with-a-long-random-string"
SESSION_DAYS="30"
# Extra origins allowed to send writes, comma separated. Usually left empty.
ALLOWED_WRITE_ORIGINS=""

# ---------- owner account ----------
# This email is promoted to ADMIN on sign-in and on Google sign-in.
ADMIN_EMAIL="itsvfxcook@gmail.com"
ADMIN_PASSWORD=""

# ---------- google sign-in (optional) ----------
# Authorised redirect URI: ${APP_URL}/api/auth/google/callback
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------- email (optional) ----------
# Without these, magic links are disabled and license codes are shown in the admin UI
# instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="VFX Cook Academy <noreply@vfxcook.com>"

# ---------- file storage ----------
# With Supabase set, uploads go to the public `uploads` bucket. Without it they are
# written to UPLOADS_DIR and served from /uploads.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
UPLOADS_DIR=""

# ---------- payments (optional) ----------
# Without these, checkout falls back to the manual UPI / QR flow with admin review.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Static QR image shown on the manual checkout panel.
QR_CODE_URL=""

# ---------- AI studio (optional) ----------
# A key stored through the admin UI takes precedence over this one.
KIE_API_KEY=""
# Public base URL the provider calls back on. Defaults to APP_URL.
CALLBACK_BASE_URL=""
