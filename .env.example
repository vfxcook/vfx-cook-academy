# ---------- database ----------
# Supabase Postgres, reached through Supavisor. Copy both strings from the project's
# Connect panel. This API is a long-lived server, so the session pooler (5432) is the
# right one; the transaction pooler (6543) is for serverless and needs &pgbouncer=true.
# Use a pooler host, not db.<ref>.supabase.co — the direct host is IPv6 only unless the
# project has the IPv4 add-on, and Render cannot reach it.
DATABASE_URL="postgresql://postgres.<project-ref>:password@<region>.pooler.supabase.com:5432/postgres?sslmode=require"
# Schema changes (prisma db push) go through this one. The session pooler is fine.
DIRECT_URL="postgresql://postgres.<project-ref>:password@<region>.pooler.supabase.com:5432/postgres?sslmode=require"

# ---------- app ----------
NODE_ENV="development"
PORT="8080"
# Public origin. In dev this is the Vite server; in production https://academy.brahmastra.studio.
APP_URL="http://localhost:5173"
# How long a sign-in lasts.
SESSION_DAYS="30"

# ---------- multi-domain auth ----------
# Share the session across every brahmastra.studio subdomain. Leave empty in local dev.
COOKIE_DOMAIN=""
# Frontends allowed to call this API with credentials. Wildcards match subdomains.
# APP_URL is always allowed; localhost ports are allowed outside production.
ALLOWED_ORIGINS=""
# Shared with the Cloudflare Worker so the API can trust the visitor IP it forwards.
PROXY_SHARED_SECRET=""

# ---------- owner account ----------
# This email is promoted to ADMIN on sign-in and on Google sign-in.
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ---------- google sign-in ----------
# Google Identity Services: the browser gets an ID token, the API verifies it. No secret.
# Defaults to the BrahmAstra Studio client; comma-separate to accept more than one.
# Add every web origin (https://academy.brahmastra.studio, http://localhost:5173) under
# "Authorised JavaScript origins" for this client in Google Cloud Console.
GOOGLE_CLIENT_ID="706720560213-1f3dmo50amk180u2a7o6qcuqh2hm435i.apps.googleusercontent.com"

# ---------- email (optional) ----------
# Without these, magic links are disabled and license codes are shown in the admin UI
# instead of being emailed.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="BrahmAstra Academy <noreply@brahmastra.studio>"

# ---------- supabase (identity mirror + file storage) ----------
# The shared BrahmAstra project. After a Google sign-in the API creates or updates the
# Supabase Auth user and `profiles` row. Uploads go to its public `uploads` bucket.
# Without the service-role key, the mirror is skipped and uploads land in UPLOADS_DIR.
SUPABASE_URL="https://frnlloffzfnohagpwsti.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""
UPLOADS_DIR=""

# ---------- payments (optional) ----------
# Without these, checkout falls back to the manual UPI / QR flow with admin review.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""
# Static QR image shown on the manual checkout panel.
QR_CODE_URL=""

# ---------- AI studio (optional) ----------
# A key stored through the admin UI takes precedence over this one.
KIE_API_KEY=""
# Public base URL the provider calls back on. Defaults to APP_URL.
CALLBACK_BASE_URL=""
# Signs provider callbacks. Optional: derived from the provider key when unset.
STUDIO_CALLBACK_SECRET=""
